# Copy to .env.local for local Next.js. Never commit real values.
# On Vercel: Settings → Environment Variables (Production + Preview).

# Doctor Strange (or any) public health URL
HEALTH_URL=https://your-app.onrender.com/health

# GitHub repo this UI commits into
GITHUB_REPO=mijanul/Keepalive
GITHUB_BRANCH=main

# Fine-grained PAT with Contents: Read and write on this repo only.
# Never prefix this with NEXT_PUBLIC_
GH_PAT=

# Optional. If set, the Commit button must send the same value.
COMMIT_SECRET=
